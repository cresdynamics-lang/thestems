# The Stems – Environment variables
# Copy to .env.local and fill in your values.

# Site
NEXT_PUBLIC_BASE_URL=https://thestemsflowers.co.ke

# Supabase (The Stems)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (login & notifications)
ADMIN_EMAIL=thestemsflowers.ke@gmail.com
ADMIN_PASSWORD=your-admin-password

# Email (Resend)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Owner phone alerts (SMS / WhatsApp) — sent on new order, paid order, contact form
# Phone defaults to shop WhatsApp (254725707143) if OWNER_PHONE is omitted
OWNER_PHONE=254725707143

# Africa's Talking SMS (https://account.africastalking.com)
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=

# Optional: CallMeBot WhatsApp to owner phone (activate once → get apikey)
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_API_KEY=

# Tawk.to live chat (owner gets phone push via Tawk mobile app)
# From Tawk dashboard → Administration → Chat Widget → Direct Chat Link / embed code:
# https://embed.tawk.to/PROPERTY_ID/WIDGET_ID
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID=

# JWT (admin session)
JWT_SECRET=your-jwt-secret

# Pesapal (PayPal/Card Payments)
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# PESAPAL_ENV=production
# PESAPAL_IPN_ID=
# PESAPAL_CALLBACK_URL=

# Google Gemini — admin product SEO from uploaded images (server-only, never commit real key)
# GEMINI_API_KEY=

# Optional
# GOOGLE_VERIFICATION=your-google-search-console-token
# DATABASE_URL=postgresql://...  (only for one-off setup scripts)
